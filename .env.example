# Set the real public domain before publishing. No invented domain is used.
NEXT_PUBLIC_SITE_URL=

# Netlify Forms accepts submissions on the hidden form template route
# after public/__forms.html is detected during deployment.
# Replace with an API, webhook or CRM endpoint if the site moves away from Netlify.
NEXT_PUBLIC_ESTIMATE_FORM_ENDPOINT=/__forms.html

# Optional Telegram notifications for Netlify Forms webhook.
# Create a bot with @BotFather and add the bot to the target chat/channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# REG.RU static hosting build uses /send.php instead of Netlify Forms.
# The build:reg-hosting script sets this value automatically.
